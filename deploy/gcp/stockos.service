[Unit]
Description=StockOS NVDA Quant research
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/stockos

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/var/lib/stockos/current
ExecStart=/usr/bin/docker compose --env-file deploy/.env -f deploy/compose.yaml -f deploy/gcp/compose.yaml up -d --wait --wait-timeout 180
ExecStop=/usr/bin/docker compose --env-file deploy/.env -f deploy/compose.yaml -f deploy/gcp/compose.yaml stop --timeout 45
TimeoutStartSec=600
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
