# Copy to an untracked .env on the deployment host; never commit credentials or seed data.
STOCKOS_IMAGE=registry.example/stockos@sha256:REPLACE_WITH_TESTED_IMAGE_DIGEST
STOCKOS_DOMAIN=stockos.example.com
STOCKOS_SEED_DIR=/opt/stockos/seed
STOCKOS_USER=researcher
# Supply your own project name and contact email for SEC requests.
SEC_USER_AGENT='StockOS your-contact@example.com'
# Generate interactively: docker run --rm -it caddy:2.11.7-alpine caddy hash-password
# Single-quote the hash in .env so Docker Compose preserves dollar signs.
STOCKOS_PASSWORD_HASH='REPLACE_WITH_BCRYPT_HASH'
