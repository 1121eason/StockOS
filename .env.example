QVE_DATABASE_URL=sqlite:///data/qve.db
QVE_LABEL_DATABASE_URL=sqlite:///data/labels.db
# Set your own organization/project and contact email. Never commit .env.
SEC_USER_AGENT=
QVE_RAW_DIR=data/raw


# M4 optional AI provider. Configure locally; never commit secrets.
QVE_AI_PROVIDER=
QVE_AI_MODEL=
QVE_AI_MODEL_VERSION=
OPENAI_API_KEY=
# Optional only when supported by the selected model
# QVE_AI_REASONING=low
# QVE_AI_TEMPERATURE=0

# M4.1 official subscription CLI; no API key required
QVE_CLAUDE_MODEL=sonnet
QVE_CLAUDE_EXECUTABLE=claude
QVE_CLI_TIMEOUT=240
